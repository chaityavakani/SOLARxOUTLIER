<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 600" width="1200" height="600">
  <defs>
    <linearGradient id="sky" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#0f1b2d" />
      <stop offset="100%" stop-color="#1e3a5f" />
    </linearGradient>
    <linearGradient id="sun" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#fbbf24" />
      <stop offset="100%" stop-color="#f59e0b" />
    </linearGradient>
  </defs>
  <rect width="1200" height="600" fill="url(#sky)" />
  <circle cx="1000" cy="150" r="100" fill="url(#sun)" opacity="0.8" />
  <!-- Solar panels array on rooftop representation -->
  <g transform="skewX(-15) translate(200, 280)" fill="#1e293b" stroke="#38bdf8" stroke-width="2">
    <rect x="0" y="0" width="120" height="70" />
    <rect x="130" y="0" width="120" height="70" />
    <rect x="260" y="0" width="120" height="70" />
    <rect x="390" y="0" width="120" height="70" />
    <rect x="0" y="80" width="120" height="70" />
    <rect x="130" y="80" width="120" height="70" />
    <rect x="260" y="80" width="120" height="70" />
    <rect x="390" y="80" width="120" height="70" />
  </g>
</svg>

